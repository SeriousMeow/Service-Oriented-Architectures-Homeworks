        {
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse-movie" },
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  cohort_date AS \"Cohort\",\n  round(100.0 * maxIf(retention, day_offset = 0), 1) AS \"Day 0\",\n  round(100.0 * maxIf(retention, day_offset = 1), 1) AS \"Day 1\",\n  round(100.0 * maxIf(retention, day_offset = 2), 1) AS \"Day 2\",\n  round(100.0 * maxIf(retention, day_offset = 3), 1) AS \"Day 3\",\n  round(100.0 * maxIf(retention, day_offset = 4), 1) AS \"Day 4\",\n  round(100.0 * maxIf(retention, day_offset = 5), 1) AS \"Day 5\",\n  round(100.0 * maxIf(retention, day_offset = 6), 1) AS \"Day 6\",\n  round(100.0 * maxIf(retention, day_offset = 7), 1) AS \"Day 7\"\nFROM v_retention_cohort_heatmap\nWHERE cohort_date >= today() - 90\nGROUP BY cohort_date\nORDER BY cohort_date DESC",
          "refId": "A"
        }
      ],
      "title": "Retention cohorts (first-view date | Day 0-7, % returned)",
      "type": "table"
